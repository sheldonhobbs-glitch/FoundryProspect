# --- Environment ---
# "development" or "production". Controls cookie security flags, etc.
ENV=development

# --- Database ---
# Full Postgres connection URL. In docker-compose this points at the "db" service.
# Railway: set this to the DATABASE_URL Railway provisions for its Postgres plugin.
DATABASE_URL=postgresql://ember:ember@localhost:5432/ember

# --- Sessions / cookies ---
# Random secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
# How many days a login session stays valid before requiring re-login.
SESSION_MAX_AGE_DAYS=30

# --- Shared household login ---
# There's no username or password. The whole login is this secret token:
# whoever visits https://<your-domain>/login/<this-value> gets a session.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then bookmark the full /login/<token> URL on both of your phones. Treat
# this value like a password — anyone who has it is logged in.
HOUSEHOLD_LOGIN_TOKEN=change-me

# --- Reminders (used starting Phase 1) ---
# How many days ahead of a due date the worker should raise a "due soon" reminder.
REMINDER_DAYS_AHEAD=3

# --- Google Calendar (used starting Phase 2) ---
# OAuth client credentials from Google Cloud Console (Calendar API enabled,
# OAuth consent screen configured, "Web application" client type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback
# "primary" syncs the connected account's main calendar. Recommended instead:
# create a separate calendar in Google Calendar (e.g. "Household") so this
# doesn't mix into a personal/work calendar, then paste its Calendar ID here
# (Google Calendar settings -> that calendar -> "Integrate calendar").
GOOGLE_CALENDAR_ID=primary

# --- Ember Brain (natural-language assistant) ---
# API key from console.anthropic.com. Server-side only — never sent to the
# browser. Set a monthly spend limit in the Anthropic console too.
ANTHROPIC_API_KEY=
EMBER_MODEL=claude-opus-5-5
# low | medium | high reasoning effort per request.
EMBER_EFFORT=low
# Max assistant requests per day (guards the API bill if the login link leaks).
EMBER_DAILY_REQUEST_LIMIT=200
# Leave false until GOOGLE_CALENDAR_ID points at a dedicated household
# calendar; while false Ember can read the calendar but not change it.
EMBER_CALENDAR_WRITES_ENABLED=false

# --- Household ---
# "Today" is computed in this time zone (the server itself runs in UTC).
HOUSEHOLD_TIMEZONE=Australia/Brisbane

# --- Web Push / VAPID (used starting Phase 6) ---
# Generate a VAPID keypair with, e.g., the `py_vapid` CLI or `web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:change-me@example.com

# --- Server ---
# Port the API listens on. Railway injects PORT automatically; default is for local dev.
PORT=8000
